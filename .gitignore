# Dependencies
node_modules/

# Build output
dist/
dist-simulator/
*.tsbuildinfo

# Test / coverage
coverage/

# Env & secrets (NEVER commit real Orion credentials or captures)
.env
.env.local
.env.*.local
secrets/
captures/
*.har
*.der

# Logs
*.log
logs/
npm-debug.log*

# Bench capture logs (overnight serial captures, docs/SPEC-power-sensing.md
# §10.7/§11.6) — raw device output, not part of the firmware or its history.
bench-logs/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Device flash backups (per-unit dumps contain NVS data such as BT bonding keys
# and must never be published; keep them local-only)
firmware/backups/*.bin

# Desktop UI simulator build output (cmake -B build -S simulator)
/build/

# Personal sleep data — must never be published
reference/sleep_temps.csv

# Local research/reference material — personal pad data, the vendor's API
# spec, and scratch viewers. Not part of the firmware; never publish.
reference/
Claude outputs/
docs/dial-audit-run.log
